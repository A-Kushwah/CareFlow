datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL Migration Note:
// For PostgreSQL production deployments, double-booking prevention is additionally enforced
// at the database engine layer using a GiST EXCLUDE constraint (see migration 20260821000000_postgresql_gist_exclusion).

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("PATIENT") // "ADMIN", "DOCTOR", "PATIENT"
  isTestFixture Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctorProfile        DoctorProfile?
  patientAppointments  Appointment[]  @relation("PatientAppointments")
  patientPrescriptions Prescription[] @relation("PatientPrescriptions")
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty       String
  consultFee      Float
  slotDurationMin Int      @default(30)
  bufferTimeMin   Int      @default(10)
  isPublished     Boolean  @default(true)
  isTestFixture   Boolean  @default(false)

  workingHours WorkingHours[]
  leaves       DoctorLeave[]
  appointments Appointment[]
  prescriptions Prescription[]
}

model WorkingHours {
  id             String        @id @default(uuid())
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek      Int           // 0=Sun, 1=Mon, ..., 6=Sat
  startTime      String        // "09:00"
  endTime        String        // "17:00"
  breakStartTime String?       // "13:00"
  breakEndTime   String?       // "14:00"
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String        @default("APPROVED") // "PENDING", "APPROVED", "CANCELLED"
  createdAt DateTime      @default(now())
}

model SlotHold {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  startTime DateTime
  endTime   DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([doctorId, startTime, endTime])
}

model Appointment {
  id                 String         @id @default(uuid())
  patientId          String
  patient            User           @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime          DateTime
  endTime            DateTime
  status             String         @default("CONFIRMED") // "HELD", "CONFIRMED", "CANCELLED", "COMPLETED"
  symptoms           String?
  aiPreSummary       String?
  aiPostSummary      String?
  consultNotes       String?
  cancellationReason String?
  calendarEventId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  prescriptions      Prescription[]

  @@index([doctorId, startTime, endTime])
}

model Prescription {
  id            String        @id @default(uuid())
  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User          @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medication    String
  dosage        String
  frequency     String
  duration      String
  instructions  String?
  createdAt     DateTime      @default(now())

  @@unique([appointmentId, medication, dosage, frequency, duration])
  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
}

model MedicationReminder {
  id            String    @id @default(uuid())
  patientId     String
  appointmentId String?
  medication    String
  dosage        String
  frequency     String
  duration      String?
  instructions  String?
  startDate     DateTime
  endDate       DateTime
  lastSentAt    DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  @@index([patientId])
  @@index([appointmentId])
}

model NotificationLog {
  id             String    @id @default(uuid())
  idempotencyKey String?   @unique
  recipient      String
  channel        String    @default("EMAIL") // "EMAIL", "SMS", "CALENDAR"
  template       String
  payload        String    // JSON string payload
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextRetryAt    DateTime  @default(now())
  status         String    @default("QUEUED") // "QUEUED", "PROCESSING", "SENT", "FAILED", "DLQ"
  claimToken     String?
  claimedAt      DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([claimToken])
}

model AiGenerationLog {
  id               String   @id @default(uuid())
  appointmentId    String?
  patientId        String?
  doctorId         String?
  action           String   // "PRE_VISIT" or "POST_VISIT"
  provider         String   // "openai", "mock", "test"
  model            String
  promptVersion    String   @default("1.0")
  status           String   // "SUCCESS", "FAILED", "TIMEOUT"
  requestId        String?
  latencyMs        Int
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  inputHash        String
  outputJson       String
  errorReason      String?
  createdAt        DateTime @default(now())

  @@index([appointmentId])
  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt])
}
