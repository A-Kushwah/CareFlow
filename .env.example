# Database Connection (SQLite default for local demo; PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Operational Adapter Mode Configuration
EMAIL_PROVIDER="console"
LLM_PROVIDER="mock"
CALENDAR_ENABLED="false"

# Session Security Secret Key
JWT_SECRET="replace-with-a-local-secret"

# Google Calendar Integration Credentials (Optional in Demo Mode)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# OpenAI / Gemini API Keys (Optional in Demo Mode)
OPENAI_API_KEY=""

# SMTP Email Relay Configuration (Optional in Demo Mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
