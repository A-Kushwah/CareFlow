# Database Connection (SQLite default for local demo; PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Operational Adapter Mode Configuration (Set LLM_PROVIDER="openai" for live mode)
EMAIL_PROVIDER="console"
LLM_PROVIDER="openai"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_MS="10000"
CALENDAR_ENABLED="false"

# Session Security Secret Key
JWT_SECRET="replace-with-a-local-secret"

# OpenAI API Key (Server key required when LLM_PROVIDER="openai"; never exposed to client)
OPENAI_API_KEY=""

# Google Calendar Integration Credentials (Optional in Demo Mode)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# SMTP Email Relay Configuration (Optional in Demo Mode)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
